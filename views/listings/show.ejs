<% layout("/layouts/boilerplate") %>
<div class="row mt-2 mt-md-4">
    <div class="col-12 col-md-10 col-lg-8 mx-auto show-container">
        <h1 class="mb-3"><%=listing.title%></h1>
   
    
        <div class="card listing-card mb-4">
            <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_image" style="height: 300px; object-fit: cover;">
            <div class="card-body">
                  <p class="card-text">
                    <strong>
                    <%if(listing.owner){%>
                        <%=listing.owner.username%>
                    <%}else{%>
                        Unknown Owner
                    <%}%>
                    </strong>
                    <br><br>
                   <%=listing.description%><br><br>
                     <strong>&#8377; <%=listing.price.toLocaleString("en-IN")%> per night</strong>
                        <br><br>
                    <span class="text-muted"><%=listing.location%>, <%=listing.country %></span>
                </p>
            </div>
        </div>
        <br>
        <div id="map-container"
             data-address="<%= (listing.location || '') + ', ' + (listing.country || '') %>"
             data-latitude="<%= listing.latitude != null ? listing.latitude : '' %>"
             data-longitude="<%= listing.longitude != null ? listing.longitude : '' %>"
             data-title="<%= listing.title || 'Listing' %>">
            <h4>Approximate Location</h4>
            <div id="map"></div>
            <p id="map-fallback" style="display:none;color:#555">Unable to locate this address. Please check the listing location and country.</p>
        </div>
    <% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
        <div class="d-flex flex-wrap gap-2 my-4">
            <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark" style="background-color: #ff6f61; border: none;">Edit</a>
            <form action="/listings/<%=listing._id%>?_method=DELETE" method="POST" class="d-inline">
            <button type="submit" class="btn btn-dark">Delete</button>
            </form> 
        </div>
    <% } %>
        
        
        <hr>
        <% if(currentUser){%>
        <div class="mb-4">
            <h4>Leave a Review</h4>
            <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <label class="form-label">Rating:</label>
                    <div class="starability-slot">
                        <input type="radio" id="rate1" name="review[rating]" value="1" required />
                        <label for="rate1" title="Terrible">1 star</label>
                        <input type="radio" id="rate2" name="review[rating]" value="2" />
                        <label for="rate2" title="Not good">2 stars</label>
                        <input type="radio" id="rate3" name="review[rating]" value="3" />
                        <label for="rate3" title="Average">3 stars</label>
                        <input type="radio" id="rate4" name="review[rating]" value="4" />
                        <label for="rate4" title="Very good">4 stars</label>
                        <input type="radio" id="rate5" name="review[rating]" value="5" />
                        <label for="rate5" title="Amazing">5 stars</label>
                    </div>
                    
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label">Comment:</label>
                    <textarea id="comment" name="review[comment]" rows="4" class="form-control" required></textarea>
                    <div class="invalid-feedback">
                        Please provide a comment for your review.
                    </div>
                </div>
                <button type="submit" class="btn btn-dark" style="background-color: #ff6f61; border: none;">Submit Review</button>
            </form>
        <%} %>

        </div>

            <hr>
             <h4 class="mb-4"><b>Reviews (<%=listing.reviews.length%>)</b></h4>
             <div class="row g-3">
                <%for(let review of listing.reviews)
                { %>
                    <div class="col-12 col-md-6 col-lg-12">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">@<%=review.author ? review.author.username : 'Unknown User'%></h5>
                                <p class="card-text"><span class="review-stars"><%= '★'.repeat(review.rating || 0) %><%= '☆'.repeat(5 - (review.rating || 0)) %></span></p>
                                <p class="card-text"><%=review.comment%></p>
                            </div>
                            <% if(currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
                            <div class="card-footer bg-light">
                            <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST">
                                <button type="submit" class="btn btn-sm btn-danger w-100">Delete Review</button>
                            </form>
                            </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
             </div>
            
                

            




        </div>
        
        <script>
            window.addEventListener('load', function() {
                const container = document.getElementById('map-container');
                const address = container.dataset.address || '';
                const title = container.dataset.title || 'Listing';
                const mapElement = document.getElementById('map');
                const fallbackElement = document.getElementById('map-fallback');

                const latValue = parseFloat(container.dataset.latitude);
                const lonValue = parseFloat(container.dataset.longitude);
                const hasCoordinates = !Number.isNaN(latValue) && !Number.isNaN(lonValue);

                if (typeof L === 'undefined') {
                    mapElement.style.display = 'none';
                    fallbackElement.textContent = 'Map library failed to load. Please refresh the page.';
                    fallbackElement.style.display = 'block';
                    return;
                }

                if (hasCoordinates) {
                    const map = L.map('map').setView([latValue, lonValue], 12);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                    }).addTo(map);
                    L.marker([latValue, lonValue]).addTo(map).bindPopup(`<strong>${title}</strong>`).openPopup();
                    return;
                }

                if (!address.trim()) {
                    mapElement.style.display = 'none';
                    fallbackElement.textContent = 'No address available for this listing.';
                    fallbackElement.style.display = 'block';
                    return;
                }

                fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=1`)
                    .then(response => response.json())
                    .then(data => {
                        if (!data || data.length === 0) {
                            mapElement.style.display = 'none';
                            fallbackElement.style.display = 'block';
                            return;
                        }

                        const { lat, lon, display_name } = data[0];
                        const map = L.map('map').setView([lat, lon], 12);
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            maxZoom: 19,
                            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                        }).addTo(map);
                        L.marker([lat, lon]).addTo(map).bindPopup(`<strong>${title}</strong><br>${display_name}`).openPopup();
                    })
                    .catch(() => {
                        mapElement.style.display = 'none';
                        fallbackElement.style.display = 'block';
                    });
            });
        </script>

    </div>
</div>